// 圓形編輯器. 顏色可用 css 變數改: --ldg-line ( 弧線 ), --ldg-ring ( 選中顏色的外框 )
.ldgradient
  --ldg-line: #e3e5e8
  --ldg-ring: #1f2329
  width: 140px
  height: 160px
  display: inline-block
  margin: 10px
  user-select: none
  -webkit-tap-highlight-color: transparent
  svg
    width: 100%
    height: 100%
    overflow: visible
  .ldg-board
    cursor: grab
  .ldg-colors g
    cursor: pointer
    transition: transform 0.3s cubic-bezier(.1,.1,0,1)
    transform-origin: 50px 50px
  .ldg-bar
    stroke: var(--ldg-line)
    stroke-dasharray: 0 62.8308 0 62.8308
    transition: stroke-dasharray 0.5s cubic-bezier(.1,.1,0,1)
  .ldg-bar.active
    stroke-dasharray: 0 0 125.6616 0
  .ldg-dot
    stroke-width: 0
    transition: r .15s ease-out
  .ldg-ring
    stroke: var(--ldg-ring)
    opacity: 0
    transition: opacity .15s linear
  .ldg-knob
    stroke: #fff
    stroke-opacity: .7
  .ldg-knob, .ldg-texts
    opacity: 0
    transition: opacity 0.3s cubic-bezier(.1,.1,0,1)
  .ldg-texts
    pointer-events: none
    [data-action]
      pointer-events: auto
      cursor: pointer
  .ldg-swatch
    stroke: #fff
    stroke-width: 1.4
  .ldg-hexrow:hover .ldg-hex
    text-decoration: underline
  text
    text-transform: uppercase
    font-family: sans-serif
    font-size: 10px
    fill: #fff
    fill-opacity: 0.9
  .ldg-pos
    text-anchor: middle
  .ldg-btn
    .ldg-hit
      fill: transparent
      stroke: none
    .ldg-ic
      fill: none
      stroke: #fff
      stroke-width: 1.1
      stroke-linecap: round
      stroke-opacity: .9
    .ldg-fill
      fill: #fff
      fill-opacity: .9
    &:hover .ldg-ic
      stroke-width: 1.5
  .ldg-btn.disabled
    opacity: .3
    pointer-events: none
.ldgradient.active, .ldgradient.pinned
  .ldg-knob, .ldg-texts
    opacity: 1
  .ldg-dot
    stroke-width: 1
  .ldg-colors g.active
    .ldg-ring
      opacity: 1
    .ldg-dot
      r: 7
  svg
    touch-action: none
.ldgradient.active.on .ldg-colors g
  transition: none
.ldgradient.dark
  text
    fill: #000
    fill-opacity: .75
  .ldg-btn .ldg-ic
    stroke: #000
    stroke-opacity: .75
  .ldg-btn .ldg-fill
    fill: #000
    fill-opacity: .75
  .ldg-knob
    stroke: #000
    stroke-opacity: .3
  .ldg-swatch
    stroke: rgba(0,0,0,.4)

// 長條編輯器. --ldgb-ring: 選中色標的外框
.ldgb
  --ldgb-ring: #1f2329
  --ldgb-line: #d5d8dd
  user-select: none
  .ldgb-rail
    position: relative
    padding-bottom: 22px
    touch-action: none
  .ldgb-track
    cursor: copy
    height: 28px
    border-radius: 6px
    overflow: hidden
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.08)
    // 透明時看得到的棋盤格
    background: repeating-conic-gradient(#e9ebee 0% 25%, #fff 0% 50%) 0 0 / 12px 12px
  .ldgb-fill
    width: 100%
    height: 100%
  .ldgb-stops
    pointer-events: none
    position: absolute
    left: 0
    right: 0
    top: 0
    bottom: 0
  .ldgb-stop
    position: absolute
    top: 22px
    width: 18px
    height: 24px
    margin-left: -9px
    pointer-events: auto
    cursor: grab
    outline: none
    -webkit-tap-highlight-color: transparent
    // 往上指的小三角
    &:before
      content: ""
      position: absolute
      left: 4px
      top: -1px
      border: 5px solid transparent
      border-top: 0
      border-bottom: 6px solid var(--ldgb-line)
    i
      position: absolute
      left: 0
      top: 5px
      width: 18px
      height: 18px
      border-radius: 5px
      border: 2px solid #fff
      box-shadow: 0 0 0 1px var(--ldgb-line), 0 1px 3px rgba(0,0,0,.15)
  .ldgb-stop.active
    z-index: 1
    &:before
      border-bottom-color: var(--ldgb-ring)
    i
      box-shadow: 0 0 0 2px var(--ldgb-ring), 0 1px 3px rgba(0,0,0,.2)
  .ldgb-stop:focus-visible i
    box-shadow: 0 0 0 2px var(--ldgb-ring), 0 0 0 5px rgba(0,120,255,.3)
  // 色碼、位置、× 、套用: 同樣 32px 高
  .ldgb-info
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 8px
    margin-top: 12px
    font-size: 14px
  .ldgb-pick
    display: flex
    align-items: center
    gap: 6px
    box-sizing: border-box
    height: 32px
    padding: 0 8px
    border: 1px solid var(--ldgb-line)
    border-radius: 6px
    cursor: pointer
    font-family: monospace
    &:hover
      border-color: var(--ldgb-ring)
  .ldgb-swatch
    width: 18px
    height: 18px
    border-radius: 4px
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.15)
  .ldgb-pos
    display: flex
    align-items: center
    gap: 2px
    margin: 0
    input
      width: 4.2em
      box-sizing: border-box
      height: 32px
      padding: 0 6px
      border: 1px solid var(--ldgb-line)
      border-radius: 6px
      font: inherit
  .ldgb-del, .ldgb-apply
    box-sizing: border-box
    width: 32px
    height: 32px
    border: 1px solid var(--ldgb-line)
    border-radius: 6px
    background: none
    font-size: 18px
    line-height: 1
    cursor: pointer
    &:hover
      border-color: var(--ldgb-ring)
    &:disabled
      opacity: .35
      cursor: default
      border-color: var(--ldgb-line)
  .ldgb-del, .ldgb-apply
    display: flex
    align-items: center
    justify-content: center
    padding: 0
    svg
      width: 15px
      height: 15px
  .ldgb-hint
    margin-left: auto
    font-size: 12px
    opacity: .55
